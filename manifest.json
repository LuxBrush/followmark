{
  "manifest_version": 3,
  "name": "FollowMark",
  "short_name": "FollowMark",
  "version": "0.1.1",
  "description": "FollowMark: Your bookmarks follow your progress automatically! Great for webcomics, wikis, blogs, and YouTube!",
  "author": "Lux Brush",

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "120": "icons/active.png"
  },

  "action": {
    "default_icon": {
      "120": "icons/inactive.png"
    },
    "default_popup": "popup.html",
    "default_title": "FollowMark - follows your progress automatically"
  },
  "permissions": ["tabs", "storage", "bookmarks", "scripting", "notifications"],
  "host_permissions": ["*://*/*"]
}
